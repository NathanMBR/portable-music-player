{
  "name": "portable-music-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "tsc --noEmit && biome check --fix",
    "lint:ci": "tsc --noEmit && biome check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "pnpm test:ts && pnpm test:rs",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ts": "vitest run",
    "test:ts:unit": "vitest run --project unit",
    "test:ts:storybook": "vitest run --project storybook",
    "test:report": "test/generate_test_report.sh",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
