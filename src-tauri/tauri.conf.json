{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chopi",
  "mainBinaryName": "chopi",
  "version": "1.0.0",
  "identifier": "com.nathan.chopi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chopi",
        "width": 1100,
        "height": 760,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Nathan Murillo",
    "homepage": "https://github.com/NathanMBR/chopi",
    "copyright": "Copyright © 2026 Nathan Murillo",
    "category": "Music",
    "shortDescription": "Music player for Windows and Linux, installed or portable",
    "longDescription": "Chopi plays MP3, M4A, AAC, Opus, Ogg, FLAC and WAV songs, with gapless playback, playlists, shuffle, repeat, keyboard shortcuts, media keys and the system's media controls.\n\nRun it installed, or portable with nothing to install, from any folder or drive: it keeps your songs, playlists and settings in its own folder.",
    "targets": ["appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4ODU2RTQ5REJEMkNEMkEKUldRcXpkTGJTVzZGNkxiNHBka0ppZkRBdHlhSWdxUG5CNXdwL3oySG5TdzhkWDZ4TlRneDRSQTAK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/NathanMBR/chopi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
